{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/lint-config/packages/oxlint-config/wxt.json",
    "./node_modules/lint-config/packages/oxlint-plugin-naming/preset.json"
  ],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest", "webextension-messages", "hook-names"],
        "allowedNames": [
          {
            "reason": "Chrome's built-in AI global, declared as the browser spells it",
            "names": ["LanguageModel"]
          }
        ],
        "allowedPatterns": [
          {
            "reason": "WXT keeps each storage item's version under a key suffixed with a dollar sign",
            "pattern": "^[a-zA-Z]+[$]$"
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["node_modules/**", ".output/**", ".wxt/**", "user-profiles/**", "patches/**"],
  "overrides": [
    {
      "files": ["src/layers/filter-editor/preview/tile-motion.ts"],
      "rules": {
        "house/positional-parameters": "off"
      }
    }
  ]
}
