{
  "name": "youtube-semi-sub",
  "version": "0.0.2",
  "private": false,
  "description": "Filter YouTube channels in your subscriptions feed: follow one without subscribing and add only the videos your filter (a RegExp or an AI match) lets through, or subscribe and hide the ones it matches",
  "homepage": "https://github.com/avi12/youtube-semi-sub",
  "bugs": "https://github.com/avi12/youtube-semi-sub/issues",
  "license": "GPL-3.0-only",
  "author": "Avi (https://avi12.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-semi-sub.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/avi12"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/avi12"
    }
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "dev": "bun run devtool dev run",
    "dev:firefox": "bun run devtool dev run --firefox",
    "dev:android": "bun run devtool dev run --android",
    "devtool": "cargo run --release --quiet --manifest-path tools/Cargo.toml --",
    "dev-server:test": "cargo test --manifest-path dev-server/Cargo.toml",
    "tools:test": "cargo test --manifest-path tools/Cargo.toml",
    "assets:check": "tsrs --noEmit -p tools/assets/tsconfig.json",
    "build": "wxt build",
    "build:firefox": "bun run build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "bun run zip -b firefox --mv3",
    "zip:edge": "bun run zip -b edge",
    "zip:opera": "bun run zip -b opera",
    "zip:all": "bun run --parallel zip zip:edge zip:opera zip:firefox",
    "compile": "tsrs --noEmit",
    "lint": "avi12-lint",
    "svelte:check": "avi12-svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare",
    "lint:fix": "avi12-lint --fix"
  },
  "dependencies": {
    "@litert-lm/core": "^0.19.0",
    "@webext-core/messaging": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.6",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "lint-config": "github:avi12/lint-config#v0.13.1",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5",
    "wxt-module-layers": "^1.3.0"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "@davestewart/wxt-utils@0.6.0": "patches/@davestewart__wxt-utils@0.6.0.patch",
    "zod@4.6.7": "patches/zod.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "spawn-sync"
  ]
}
