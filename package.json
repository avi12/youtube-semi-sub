{
  "name": "youtube-semi-sub",
  "version": "0.1.0",
  "private": false,
  "description": "Filter YouTube channels in your subscriptions feed: follow one without subscribing and add only the videos your filter (a RegExp or an AI match) lets through, or subscribe and hide the ones it matches",
  "homepage": "https://github.com/avi12/youtube-semi-sub",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-semi-sub.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "pnpm build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "pnpm zip -b firefox --mv3",
    "compile": "tsrs --noEmit",
    "lint": "avi12-lint",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare",
    "lint:fix": "avi12-lint --fix"
  },
  "dependencies": {
    "@litert-lm/core": "^0.19.0",
    "@webext-core/messaging": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.6",
    "@wxt-dev/module-svelte": "2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.4.14&path:/packages/avi12-lint",
    "eslint": "^10.15.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.14&path:/packages/eslint-config",
    "eslint-plugin-svelte": "3.24.1",
    "fallow": "2.104.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.14&path:/packages/fallow-config",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.14&path:/packages/oxfmt-config",
    "oxlint": "1.94.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.14&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.14&path:/packages/oxlint-plugin-naming",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "stylelint": "^18.0.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.14&path:/packages/stylelint-config",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5",
    "wxt-module-layers": "^1.3.0"
  },
  "packageManager": "pnpm@11.13.1"
}
