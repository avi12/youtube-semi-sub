{
  "name": "youtube-semi-sub",
  "version": "0.1.0",
  "private": false,
  "description": "Filter YouTube channels in your subscriptions feed: follow one without subscribing and add only the videos your filter (a RegExp or an AI match) lets through, or subscribe and hide the ones it matches",
  "homepage": "https://github.com/avi12/youtube-semi-sub",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avi12/youtube-semi-sub.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "pnpm build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "pnpm zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "lint": "avi12-lint",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "fallow": "fallow audit --base HEAD",
    "postinstall": "wxt prepare",
    "lint:fix": "avi12-lint --fix"
  },
  "dependencies": {
    "@ktibow/material-color-utilities-nightly": "^0.4.1772748028000",
    "@litert-lm/core": "^0.18.0",
    "@webext-core/messaging": "^4.0.0",
    "fast-xml-parser": "^5.11.2",
    "m3-svelte": "^7.2.1",
    "vite-plugin-functions-mixins": "^0.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "avi12-lint": "github:avi12/lint-config#v0.4.10&path:/packages/avi12-lint",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/eslint-config",
    "eslint-plugin-svelte": "3.23.1",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.10&path:/packages/oxlint-plugin-naming",
    "postcss": "^8.5.30",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.10&path:/packages/stylelint-config",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "1.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4",
    "wxt-module-layers": "^1.3.0"
  },
  "packageManager": "pnpm@11.13.1"
}
