{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": ["./node_modules/lint-config/packages/fallow-config/fallow.json"],
  "entry": [
    "src/layers/*/entrypoints/*.content.ts",
    "src/layers/*/entrypoints/*/index.{ts,html}",
    "src/layers/*/layer.config.ts"
  ],
  "ignoreUnresolvedImports": ["#imports"],
  "ignorePatterns": ["dev-server/bindings/**", "tools/bindings/**", "tools/assets/**"],
  "ignoreDependencies": [
    "postcss-html",
    "svelte-check",
    "lint-config",
    "stylelint-config-ccb",
    "typescript-eslint",
    "globals"
  ],
  "health": { "maxCognitive": 30, "maxCrap": 10000 },
  "rules": { "unused-enum-members": "warn" },
  "overrides": [
    {
      "files": ["src/lib/youtube/page/yt-icon.ts", "src/lib/youtube/page/button-view-model.ts"],
      "rules": { "unused-enum-members": "off" }
    }
  ]
}
